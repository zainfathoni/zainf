SESSION_SECRET=anything
MAILGUN_API_KEY=key-somethingrandom
MAILGUN_MAILING_LIST=mailing-list@mg.yourdomain.com
# /ama form. Use placeholders only; see docs/ama.md.
AMA_WORKER_URL=https://zainf-ama.example.workers.dev/questions
AMA_SUBMISSION_SECRET=replace-with-random-shared-secret
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Private owner inbox. Never use the submission secret for inbox reads.
AMA_READ_SECRET=replace-with-separate-random-read-secret
AMA_GITHUB_CLIENT_ID=replace-with-dedicated-github-oauth-client-id
AMA_GITHUB_CLIENT_SECRET=replace-with-dedicated-github-oauth-client-secret
AMA_GITHUB_OWNER_ID=6315466
# Canonical base64url-encoded 32-byte encryption key. No development fallback.
AMA_SESSION_KEY=replace-with-base64url-session-key
# Production default: https://www.zainfathoni.com. Loopback HTTP is dev-only.
AMA_ADMIN_ORIGIN=https://www.zainfathoni.com
