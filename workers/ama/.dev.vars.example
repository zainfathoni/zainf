# Copy to .dev.vars for local Worker development. Do not put production values here.
# Dummy Turnstile keys always pass Siteverify with hostname "localhost" and action "test".
AMA_SUBMISSION_SECRET=local-only-replace-with-random-value
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=localhost
TURNSTILE_EXPECTED_ACTION=test
